{
  "compilerOptions": {
    "incremental": true,
    "target": "ES6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/libs/*": [
        "./libs/*"
      ],
      "@/plugins/*": [
        "./plugins/*"
      ],
      "@/resources/*": [
        "./resources/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/data/*": [
        "./data/*"
      ],
      "@/layouts/*": [
        "./layouts/*"
      ],
      "@/css/*": [
        "./css/*"
      ],
      "contentlayer/generated": [
        "./.contentlayer/generated"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "defs/**/*.ts",
    "libs/**/*.ts",
    "plugins/**/*.ts",
    "data/**/*.ts",
    "resources/**/*.ts",
    ".contentlayer/generated/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".cache",
    "vault",
    "output"
  ]
}
