{
  "name": "reality-design-lab-website",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "content": "node scripts/prebuild.mjs && contentlayer2 build && node scripts/prune-published-assets.mjs --apply",
    "predev": "npm run content",
    "dev": "next dev --webpack",
    "prebuild": "npm run content",
    "build": "next build --webpack && node scripts/check-build-traces.mjs",
    "serve": "next start",
    "analyze": "ANALYZE=true npm run build",
    "lint": "eslint app components defs libs plugins scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:content": "node scripts/audit-content.mjs"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.3.5",
    "@types/lodash": "4.17.25",
    "@types/unist": "3.0.3",
    "chalk": "6.0.0",
    "contentlayer2": "0.5.8",
    "dotenv": "18.0.2",
    "esbuild": "0.28.2",
    "fs-extra": "11.4.0",
    "github-slugger": "2.0.0",
    "glob": "13.0.6",
    "gray-matter": "4.0.3",
    "lodash": "4.18.1",
    "mdast-util-wiki-link": "0.1.2",
    "micromark": "4.0.2",
    "moment": "2.31.0",
    "next": "16.3.5",
    "next-contentlayer2": "0.5.8",
    "pliny": "0.4.1",
    "postcss": "8.5.28",
    "probe-image-size": "7.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.4",
    "swiper": "14.2.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "@tailwindcss/postcss": "4.3.3"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "toml": "^4.2.0",
    "uuid": "^11.1.1",
    "js-yaml@>=4 <5": "4.3.2",
    "@opentelemetry/propagator-jaeger": "2.11.0"
  }
}
